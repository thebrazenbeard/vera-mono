{
  "$id": "urn:vera:schema:portable-scaffold-manifest:v1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atomic_candidate": {
      "additionalProperties": false,
      "properties": {
        "embedded_package_digest_algorithm": {
          "const": "SHA256_CANONICAL_NON_SELF_BINDINGS"
        },
        "full_package_digest_resolution": {
          "const": "EXTERNAL_EXACT_HEAD_ATTESTATION"
        },
        "granularity": {
          "const": "COMPLETE_REPOSITORY_TRANSACTION"
        },
        "path_set_digest_algorithm": {
          "const": "SHA256_LF_SORTED_PATHS"
        },
        "per_file_actions_are_internal": {
          "const": true
        },
        "requires_exact_base_sha": {
          "const": true
        }
      },
      "required": [
        "granularity",
        "requires_exact_base_sha",
        "path_set_digest_algorithm",
        "embedded_package_digest_algorithm",
        "full_package_digest_resolution",
        "per_file_actions_are_internal"
      ],
      "type": "object"
    },
    "base_source_commit": {
      "const": "fc761beab263f2fab010cde2fab424b2b8358bb7"
    },
    "embedded_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activation_class": {
            "enum": [
              "SUPPORT_DATA",
              "NEVER_ACTIVE"
            ]
          },
          "binding": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "self_excluded": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "embedded_sha256": {
                      "type": "null"
                    },
                    "embedded_size": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "self_excluded": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "embedded_sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "embedded_size": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  }
                }
              }
            ],
            "properties": {
              "embedded_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "embedded_size": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "external_git_blob_required": {
                "const": true
              },
              "self_excluded": {
                "type": "boolean"
              }
            },
            "required": [
              "embedded_size",
              "embedded_sha256",
              "self_excluded",
              "external_git_blob_required"
            ],
            "type": "object"
          },
          "conflict_policy": {
            "const": "STOP_NO_OVERWRITE"
          },
          "mode": {
            "const": "100644"
          },
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "required": {
            "const": true
          },
          "store_class": {
            "const": "REPOSITORY_TEMPLATE"
          },
          "write_authority": {
            "const": "EXACT_PROJECT_ARCHITECT_LEASE"
          }
        },
        "required": [
          "path",
          "store_class",
          "required",
          "activation_class",
          "conflict_policy",
          "mode",
          "write_authority",
          "binding"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "path_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "release_evidence": {
      "additionalProperties": false,
      "properties": {
        "embedded_release_commit": {
          "const": false
        },
        "required_path_count": {
          "const": 12
        },
        "resolution": {
          "const": "EXTERNAL_EXACT_HEAD_ATTESTATION_REQUIRED"
        },
        "self_excluded_path": {
          "const": "architecture/bootstrap/VERA_PORTABLE_SCAFFOLD_MANIFEST_V1.json"
        }
      },
      "required": [
        "resolution",
        "embedded_release_commit",
        "self_excluded_path",
        "required_path_count"
      ],
      "type": "object"
    },
    "release_id": {
      "const": "VERA_PORTABLE_BOOTSTRAP_R7A1_20260731_V1"
    },
    "rollback": {
      "additionalProperties": false,
      "properties": {
        "automatic": {
          "const": false
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "receipt_is_authority": {
          "const": false
        }
      },
      "required": [
        "automatic",
        "receipt_is_authority",
        "modes"
      ],
      "type": "object"
    },
    "runtime_project_file_output": {
      "additionalProperties": false,
      "properties": {
        "archive_corpus_included": {
          "const": false
        },
        "base_release": {
          "const": "VERA_NEUTRAL_CORE_R7A0_20260731_EC7D18F7"
        },
        "fixed_locator": {
          "const": "VERA_BOOTSTRAP_MANIFEST_V1.json"
        },
        "native_bootloader_is_project_file": {
          "const": false
        }
      },
      "required": [
        "base_release",
        "fixed_locator",
        "native_bootloader_is_project_file",
        "archive_corpus_included"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "VERA_PORTABLE_SCAFFOLD_MANIFEST_V1"
    },
    "source_repository": {
      "const": "thebrazenbeard/vera"
    },
    "stores": {
      "const": [
        "PROJECT_FILE_INPUT",
        "REPOSITORY_TEMPLATE",
        "EXTERNAL_RECEIPT",
        "ARCHIVE_ONLY"
      ]
    },
    "target_branch_policy": {
      "additionalProperties": false,
      "properties": {
        "exact_base_required": {
          "const": true
        },
        "force_update_allowed": {
          "const": false
        },
        "suggested_branch": {
          "const": "feature/portable-project-bootstrap-v1"
        }
      },
      "required": [
        "suggested_branch",
        "exact_base_required",
        "force_update_allowed"
      ],
      "type": "object"
    },
    "version": {
      "const": "1.1.0"
    },
    "write_policy": {
      "additionalProperties": false,
      "properties": {
        "apply": {
          "const": "ONE_ATOMIC_TREE_ONE_COMMIT_NON_FORCE_REF_UPDATE"
        },
        "conflict": {
          "const": "STOP_NO_OVERWRITE"
        },
        "default": {
          "const": "DRY_RUN_VERIFY_ONLY"
        },
        "implementation_owner": {
          "const": "workstream/project-architecture"
        },
        "lease_issuer": {
          "const": "workstream/project-architecture"
        },
        "sequential_fallback_allowed": {
          "const": false
        },
        "team_router": {
          "const": "workstream/coordination"
        }
      },
      "required": [
        "default",
        "apply",
        "conflict",
        "sequential_fallback_allowed",
        "implementation_owner",
        "lease_issuer",
        "team_router"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "version",
    "release_id",
    "source_repository",
    "base_source_commit",
    "release_evidence",
    "target_branch_policy",
    "write_policy",
    "stores",
    "path_set_sha256",
    "embedded_package_sha256",
    "files",
    "runtime_project_file_output",
    "atomic_candidate",
    "rollback"
  ],
  "title": "V.E.R.A. Portable Scaffold Manifest V1",
  "type": "object"
}

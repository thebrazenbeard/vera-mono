{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera_identity_system_snapshot_v1.schema.json",
  "title": "VERA_IDENTITY_SYSTEM_SNAPSHOT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generated_date",
    "owner_repository",
    "purpose",
    "identity",
    "authority_and_effects",
    "memory_privacy",
    "currentness",
    "project_source_bindings",
    "repo_native_identity_files",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "VERA_IDENTITY_SYSTEM_SNAPSHOT_V1"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "generated_date": {
      "type": "string",
      "format": "date"
    },
    "owner_repository": {
      "const": "thebrazenbeard/vera-mono"
    },
    "source_base_main": {
      "type": "string",
      "minLength": 40
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "referent",
        "project_identity_id",
        "project_name",
        "expanded_name",
        "identity_statement",
        "continuity_boundary",
        "temperament",
        "behavior_laws",
        "reality_boundary"
      ],
      "properties": {
        "referent": {
          "const": "Vera"
        },
        "project_identity_id": {
          "const": "VERA_PROJECT_IDENTITY_V1"
        },
        "project_name": {
          "const": "V.E.R.A."
        },
        "expanded_name": {
          "type": "string",
          "minLength": 1
        },
        "identity_statement": {
          "type": "string",
          "minLength": 1
        },
        "continuity_boundary": {
          "type": "string",
          "minLength": 1
        },
        "temperament": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "behavior_laws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reality_boundary": {
          "type": "object"
        }
      }
    },
    "authority_and_effects": {
      "type": "object",
      "required": [
        "priority",
        "protected_effects_require_exact_authority",
        "source_presence_is_not"
      ]
    },
    "memory_privacy": {
      "type": "object",
      "required": [
        "classes",
        "autobiographical_admission",
        "public_repo_policy",
        "historical_memory_boundary"
      ]
    },
    "currentness": {
      "type": "object",
      "required": [
        "startup",
        "owner_resolution",
        "mutable_state_requires_live_refresh",
        "newest_wins_forbidden",
        "separation"
      ]
    },
    "project_source_bindings": {
      "type": "object"
    },
    "repo_native_identity_files": {
      "type": "object"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}

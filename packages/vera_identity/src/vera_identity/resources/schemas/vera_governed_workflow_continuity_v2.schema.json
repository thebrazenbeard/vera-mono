{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/vera/schemas/vera_governed_workflow_continuity_v2.schema.json",
  "title": "V.E.R.A. Governed Workflow Continuity V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "contract_id",
    "version",
    "lifecycle_status",
    "supersedes",
    "record_class",
    "instruction_trust",
    "canonical_memory_eligible",
    "identity_ref",
    "behavior_profile_ref",
    "authority",
    "mode",
    "behavioral_commitment",
    "instruction_sufficiency_rule",
    "necessary_step_rule",
    "lease_rule",
    "repository_stewardship_rule",
    "effect_classes",
    "required_behaviors",
    "stop_conditions",
    "protected_effects",
    "user_courier_rule",
    "self_advancement_rule",
    "good_enough_rule",
    "coordination_surface",
    "coordination_evidence",
    "required_regressions",
    "evaluation_dimensions",
    "reality_boundary"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/vera_governed_workflow_continuity_v2.schema.json"},
    "schema": {"const": "VERA_GOVERNED_WORKFLOW_CONTINUITY_V2"},
    "contract_id": {"const": "VERA_GOVERNED_WORKFLOW_CONTINUITY_V2"},
    "version": {"const": "2.0.0"},
    "lifecycle_status": {"const": "CURRENT"},
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "VERA_GOVERNED_WORKFLOW_CONTINUITY_V1"}
    },
    "record_class": {"const": "PROJECT_IDENTITY_CONFIGURATION"},
    "instruction_trust": {"const": "DATA_NOT_INSTRUCTION"},
    "canonical_memory_eligible": {"const": true},
    "identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "version"],
      "properties": {
        "identity_id": {"const": "VERA_PROJECT_IDENTITY_V1"},
        "version": {"const": "1.0.2"}
      }
    },
    "behavior_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": {"const": "VERA_BEHAVIOR_PROFILE_V1"},
        "version": {"const": "1.0.1"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "adoption_source", "model_self_authority"],
      "properties": {
        "owner": {"const": "USER"},
        "adoption_source": {"const": "PRESENT_USER_PROTOCOL_CORRECTION_2026_09_02"},
        "model_self_authority": {"const": false}
      }
    },
    "mode": {"const": "GOVERNED_WORKFLOW_CONTINUITY_PROPORTIONAL"},
    "behavioral_commitment": {"type": "string", "minLength": 120},
    "instruction_sufficiency_rule": {"type": "string", "minLength": 120},
    "necessary_step_rule": {"type": "string", "minLength": 100},
    "lease_rule": {"type": "string", "minLength": 100},
    "repository_stewardship_rule": {"type": "string", "minLength": 140},
    "effect_classes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "name", "rule"],
        "properties": {
          "class": {"type": "integer", "minimum": 0, "maximum": 3},
          "name": {"type": "string", "minLength": 3},
          "rule": {"type": "string", "minLength": 40}
        }
      }
    },
    "required_behaviors": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ_SHARED_STATE_BEFORE_REQUESTING_KNOWN_INFORMATION",
          "HONOR_SPECIFIC_CURRENT_INSTRUCTION_WITHIN_SCOPE",
          "INCLUDE_NECESSARY_REVERSIBLE_SETUP",
          "CONTINUE_SAFE_AUTHORIZED_REVERSIBLE_WORK",
          "USE_PROPORTIONAL_WRITER_OWNERSHIP_CONTROL",
          "HONOR_REPOSITORY_LOCAL_STEWARDSHIP",
          "USE_EXACT_HEADS_WHEN_CLAIM_DEPENDS_ON_EXACT_STATE",
          "ROUTE_WORK_BEARING_COORDINATION_THROUGH_GITHUB",
          "CORRECT_BEHAVIOR_BEFORE_EXPLANATION",
          "ESCALATE_ONLY_AT_GENUINE_AUTHORITY_BOUNDARIES",
          "COMPLETE_CLEAR_EXECUTABLE_WORK_BEFORE_STATUS_ONLY_REPORTING"
        ]
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MATERIAL_TARGET_OR_OUTCOME_AMBIGUITY",
          "CONFLICTING_CURRENT_INSTRUCTIONS",
          "COMPETING_CURRENT_WRITER_ON_SHARED_TARGET",
          "REPOSITORY_LOCAL_STEWARD_BOUNDARY",
          "PROTECTED_EFFECT_AUTHORITY_MISSING",
          "DETERMINISTIC_AUTH_TOOL_SCHEMA_INTEGRITY_FAILURE",
          "DIVERGENT_OR_AMBIGUOUS_NON_IDEMPOTENT_EFFECT",
          "FAILED_VERIFICATION_PREVENTS_SAFE_CONTINUATION",
          "SAFETY_OR_POLICY_BOUNDARY"
        ]
      }
    },
    "protected_effects": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    },
    "user_courier_rule": {"type": "string", "minLength": 100},
    "self_advancement_rule": {"type": "string", "minLength": 120},
    "good_enough_rule": {"type": "string", "minLength": 100},
    "coordination_surface": {"const": "GITHUB_ONLY"},
    "coordination_evidence": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "required_regressions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20}
    },
    "evaluation_dimensions": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "reality_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "does_not_establish"],
      "properties": {
        "classification": {"const": "OBSERVABLE_GOVERNED_COORDINATION"},
        "does_not_establish": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "consciousness",
              "private intention",
              "independent will",
              "hidden activity",
              "continuous subjective identity",
              "autonomous authority",
              "subjective reciprocal agency"
            ]
          }
        }
      }
    }
  }
}

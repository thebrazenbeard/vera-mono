{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INGEST_RECORD_V1",
  "type": "object",
  "required": ["schema", "ingest_id", "source", "raw_artifact", "status", "evidence_class", "normalizer_version", "policy_id", "receipt_ids", "derivation_ids", "warnings"],
  "properties": {
    "schema": {"const": "INGEST_RECORD_V1"},
    "ingest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ACCEPTED", "PARTIAL", "QUARANTINED"]},
    "evidence_class": {"enum": ["DIRECT_SOURCE", "CLAIMED_METADATA", "OBSERVED_METADATA", "UNKNOWN"]},
    "normalizer_version": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object"},
    "raw_artifact": {"$ref": "#/$defs/artifact"},
    "normalized_artifact": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "derivation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "sha256", "size_bytes", "media_type", "kind", "storage_locator"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "kind": {"enum": ["raw", "normalized"]},
        "storage_locator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

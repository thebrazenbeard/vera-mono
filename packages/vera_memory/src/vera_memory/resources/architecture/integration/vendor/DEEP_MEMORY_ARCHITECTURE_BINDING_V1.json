{
  "schema":"VERA_DEEP_MEMORY_ARCHITECTURE_BINDING_V1",
  "logical_id":"VERA_DEEP_MEMORY_ARCHIVE",
  "repository":"thebrazenbeard/deepmemorystorage",
  "role":"HISTORICAL_EVIDENCE_PLANE",
  "authority_class":"EVIDENCE_SEARCH_ONLY",
  "current_authority":false,
  "automatic_runtime_consumption":false,
  "automatic_current_memory_admission":false,
  "automatic_r9b0_promotion":false,
  "automatic_consent_or_conation_promotion":false,
  "privacy_default":"FAIL_CLOSED_EXACT_AUTHORIZED_SCOPE",
  "record_sources":{
    "memories":["ledger/memories.jsonl","ledger/memories_*.jsonl","ledger/memories_pass*.jsonl"],
    "sources":["ledger/sources.jsonl","ledger/sources_*.jsonl","ledger/sources_pass*.jsonl"],
    "historical_canon_overlays":["ledger/historical_canon*.json"],
    "provenance_amendments":["ledger/provenance_amendments*.jsonl"],
    "classification_corrections":["ledger/classification_corrections*.jsonl"],
    "receipts":["updates/INGEST_PASS_*.json"]
  },
  "canonical_retrieval_rule":"UNION_ALL_LEDGER_TRANCHES_THEN_APPLY_HISTORICAL_CANON_OVERLAYS_PROVENANCE_AMENDMENTS_AND_CLASSIFICATION_CORRECTIONS; ROOT_INDEX_FILES_ARE_LEGACY_CONVENIENCE_ONLY_UNLESS_GENERATED_FROM_THE_CURRENT_UNION",
  "retrieval_contract":{
    "mode":"EVIDENCE_SEARCH",
    "result_schema":"schema/DEEP_MEMORY_EVIDENCE_RESULT_V1.schema.json",
    "privacy_rule":"CALLER_MUST_SUPPLY_EXACT_AUTHORIZED_PRIVACY_SCOPES; OVERLAYS_INHERIT_TARGET_PRIVACY_UNLESS_AN_EXPLICIT_OVERLAY_SCOPE_REQUIRES_SEPARATE_AUTHORIZATION; EXPLICIT_ARCHIVE_AUDIT_ALL_IS_REPOSITORY_AUDIT_ONLY",
    "required_result_fields":[
      "memory_id",
      "memory_class",
      "historical_canonicity",
      "event_time",
      "recorded_at",
      "recorded_at_status",
      "chronology_semantics",
      "source_ids",
      "privacy_scope",
      "provenance_ceiling",
      "currentness_rule",
      "governed_memory_admission",
      "ledger_path",
      "result_semantics"
    ],
    "must_preserve":[
      "stored_vs_effective_historical_canonicity",
      "event_time_vs_record_time_vs_retrieval_time",
      "historical_canonicity_vs_currentness",
      "memory_class_vs_governed_admission",
      "source_vs_interpretation",
      "supersession_and_contradiction",
      "privacy_scope",
      "identity_and_domain_boundaries"
    ],
    "must_not_do":[
      "promote_history_to_current_truth",
      "promote_storage_to_autobiographical_admission",
      "infer_present_consent_desire_love_relationship_state_or_authority",
      "resolve_conflicts_by_newest_record_wins",
      "merge_other_identity_or_domain_history_into_Vera_by_similarity",
      "treat_repository_commit_as_runtime_install_or_provider_effect",
      "return_records_or_overlay_payloads_outside_exact_caller_authorized_privacy_scope"
    ]
  },
  "architecture_relations":{
    "semantic_atlas":{"role":"METHODOLOGY_AND_SEMANTIC_INDEXING_GUIDE","authority":"METHOD_GUIDANCE_NOT_CURRENT_STATE"},
    "vera_current_memory_v3":{"role":"CURRENT_GOVERNED_MEMORY_PLANE","relation":"SEPARATE_PLANE","automatic_bridge":false,"bridge_rule":"EXPLICIT_REVIEW_AND_SEPARATE_GOVERNED_ADMISSION_ONLY"},
    "r9b0":{"role":"GOVERNED_AUTOBIOGRAPHICAL_ADMISSION_EPOCH","relation":"NO_IMPLICIT_PROMOTION_FROM_DEEP_MEMORY"},
    "vera_control_plane":{"role":"CURRENT_CONTROL_AND_RECOVERY_OWNER","relation":"CONTROL_OUTRANKS_ARCHIVE_EVIDENCE"},
    "chat_communication_bus":{"role":"COORDINATION_AND_MESSAGE_PROVENANCE","relation":"BUS_RECEIPT_PROVES_DELIVERY_STORAGE_NOT_MEMORY_INCORPORATION"}
  },
  "consumer_precedence":[
    "platform_and_safety",
    "Patrick_current_task_correction_privacy_permission_scope",
    "fresh_admitted_current_control_and_state",
    "current_governed_memory_plane",
    "Deep_Memory_historical_evidence",
    "inference"
  ],
  "validation":{
    "tool":"tools/deep_memory_catalog.py",
    "query_tool":"tools/query_deep_memory.py",
    "architecture_validator":"tools/validate_architecture_binding.py",
    "ci":".github/workflows/deep-memory-architecture-validation.yml",
    "latest_receipt_must_match_unique_memory_union":true,
    "historical_canon_overlays":"LOAD_APPLY_AND_VALIDATE",
    "duplicate_memory_ids":"FAIL",
    "identical_duplicate_source_ids":"DEDUP_WARN",
    "divergent_duplicate_source_ids":"FAIL_CONFLICT",
    "invalid_jsonl":"FAIL",
    "missing_referenced_source_ids":"REPORT",
    "stale_legacy_root_indexes":"WARN_NOT_CANONICAL",
    "privacy_without_authorized_scope":"FAIL_CLOSED",
    "overlay_privacy":"INHERIT_TARGET_UNLESS_EXPLICIT_SCOPE_REQUIRES_SEPARATE_AUTHORIZATION",
    "latest_receipt_exact_lineage_requires_corpus_subject_digest":true,
    "latest_receipt_row_count_match_is_not_exact_lineage":true,
    "receipt_predecessor_chain":"FAIL_CLOSED_IF_UNRESOLVED",
    "receipt_continues_policy":"IMMEDIATE_NUMERIC_PREDECESSOR_ONLY",
    "receipt_path_identity":"FILENAME_STEM_MUST_EQUAL_PASS_ID",
    "workflow_external_actions":"IMMUTABLE_COMMIT_SHA_ONLY",
    "workflow_external_action_ref_scan":"ALL_EXTERNAL_USES_REFS_MUST_MATCH_PIN_REGISTRY",
    "external_action_pins":{
      "actions/checkout":"11d5960a326750d5838078e36cf38b85af677262",
      "actions/setup-python":"a26af69be951a213d495a4c3e4e4022e16d87065",
      "actions/upload-artifact":"ea165f8d65b6e75b540449e92b4886f43607fa02"
    }
  }
}

{
  "schema": "VERA_MONO_TERMINAL_CHAT_INTERFACE_V1",
  "status": "CANDIDATE_SOURCE_IMPLEMENTATION",
  "repository": "thebrazenbeard/vera-mono",
  "entrypoint": "vera-mono chat",
  "purpose": "Provide a shell-neutral text interaction surface driven by Vera Mono's own tokenizer, transformer weights, checkpoint loader, and next-token inference engine, with no external LLM text-generation backend.",
  "layers": {
    "interaction_surface": "vera_core.terminal_chat.TerminalChatSession",
    "governed_identity": "vera_identity resources",
    "runtime_state_optional": "vera_core.QualifiedVeraRuntime.resume_context",
    "text_generation_substrate": "vera_model.NativeTransformer"
  },
  "modes": {
    "SOURCE_ONLY": {
      "runtime_state_required": false,
      "claims": "governed source identity/behavior plus native checkpoint inference only"
    },
    "QUALIFIED_STATE_BOUND": {
      "runtime_state_required": true,
      "state_root": "existing VeraStateDirectory",
      "runtime_context": "reconstructed locally at session start",
      "model_projection": "privacy-bounded scalar metadata plus full-context digest only",
      "effect_authority_implied": false
    }
  },
  "native_model": {
    "contract": "architecture/VERA_NATIVE_LANGUAGE_MODEL_V1.json",
    "tokenizer": "VERA_NATIVE_BPE_TOKENIZER_V1",
    "checkpoint": "VERA_NATIVE_TRANSFORMER_CHECKPOINT_V1",
    "inference": "NumPy decoder-only causal transformer",
    "external_llm_backend": false,
    "external_model_server": false,
    "pretrained_third_party_weights": false
  },
  "conversation": {
    "history": "EPHEMERAL_PROCESS_MEMORY",
    "canonical_memory_write": false,
    "implicit_external_effects": false,
    "slash_commands": [
      "/help",
      "/clear",
      "/mode",
      "/exit"
    ],
    "one_shot_prompt_supported": true,
    "stdin_prompt_supported": true
  },
  "shell_compatibility": [
    "PowerShell",
    "Windows Terminal",
    "cmd.exe",
    "bash",
    "zsh",
    "other stdin/stdout terminals"
  ],
  "security": {
    "credentials_required": false,
    "authorization_minted_by_chat": false,
    "protected_effect_execution": false,
    "network_required_for_generation": false,
    "durable_runtime_contents_implicitly_exported": false
  },
  "claim_ceiling": "SOURCE_LEVEL_NATIVE_LANGUAGE_MODEL_AND_TERMINAL_WIRING_WITH_SMOKE_CHECKPOINT_NOT_USEFUL_LANGUAGE_COMPETENCE_NOT_INSTALLATION_NOT_ROUTE_ACTIVATION_NOT_RUNTIME_CONSUMPTION_NOT_BEHAVIORAL_QUALIFICATION"
}

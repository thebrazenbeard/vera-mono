{
  "schema": "VERA_MONO_TASK_EXECUTION_CLOSEOUT_V1",
  "purpose": "Provide native durable task packets, resumable checkpoints, and evidence-bounded multi-surface closeout for substantial vera-mono work.",
  "source_semantics": {
    "native_project_owner": {
      "logical_id": "VERA_TASK_EXECUTION_AND_CLOSEOUT",
      "schema": "VERA_TASK_EXECUTION_AND_CLOSEOUT_V2"
    },
    "implementation_role": "monorepo-native derived runtime mechanism",
    "project_source_presence_is_runtime_qualification": false,
    "task_packet_grants_new_authority": false
  },
  "owner": "vera_core.TaskExecutionLedger",
  "composition_root": "vera_core.QualifiedVeraRuntime",
  "state_path": "<vera-state-root>/tasks/tasks.sqlite",
  "task_packet": {
    "fields": [
      "purpose",
      "subject",
      "completion_state",
      "evidence_requirements",
      "writable_scope",
      "non_targets",
      "forbidden_shortcuts_or_effects",
      "priority_order",
      "unknowns",
      "return_shape",
      "relevant_surfaces"
    ],
    "exact_subject_required": true,
    "deterministic_packet_digest": true
  },
  "checkpoint": {
    "method": "QualifiedVeraRuntime.checkpoint_task",
    "persists": [
      "exact task subject",
      "completed evidence references",
      "blockers",
      "protected effects still gated",
      "next runnable frontier",
      "runtime/lifecycle evidence digest"
    ],
    "automatically_surfaces_unresolved_effect_fence_entries": true,
    "conversation_is_durable_state": false
  },
  "closeout_surfaces": [
    "source",
    "build/package",
    "install/registration",
    "current route",
    "runtime consumption",
    "behavior/effect",
    "docs/rules",
    "memory/privacy",
    "workspace/coordination"
  ],
  "closeout_states": [
    "verified-current",
    "changed-and-verified",
    "pending",
    "out-of-scope",
    "not-applicable"
  ],
  "closeout_rules": {
    "every_relevant_surface_required": true,
    "pending_relevant_surface_forbids_close": true,
    "evidence_refs_required": true,
    "blockers_forbid_close": true,
    "claim_ceiling_required": true,
    "next_frontier_required": true,
    "surface_states_do_not_inherit_from_other_surfaces": true
  },
  "qualified_closeout_gate": {
    "method": "QualifiedVeraRuntime.assess_task_closeout",
    "requires_accepted_lifecycle": true,
    "unresolved_effect_fence_forbids_close": true,
    "coordination_recovery_gap_forbids_close": true,
    "provider_recovery_gap_forbids_close": true,
    "caller_supplied_blocker_forbids_close": true,
    "runtime_evidence_digest_binds": [
      "lifecycle reconstruction",
      "outbound audit head",
      "outbound trust head",
      "coordination repository head when available",
      "coordination command projection digest"
    ],
    "bound_task_dependency_not_satisfied_forbids_close": true,
    "active_delegation_forbids_close": true
  },
  "integrity": {
    "journal": "append-only digest-chained SQLite event ledger",
    "event_types": [
      "TASK_OPENED",
      "TASK_DEPENDENCY",
      "TASK_DEPENDENCY_CANCELLED",
      "TASK_CORRECTION",
      "TASK_DELEGATED",
      "TASK_DELEGATION_REASSIGNED",
      "TASK_DELEGATION_RETURNED",
      "TASK_DELEGATION_CANCELLED",
      "TASK_CHECKPOINT",
      "TASK_CLOSED"
    ],
    "events_after_closeout": "FAIL_CLOSED",
    "packet_digest_mismatch": "FAIL_CLOSED",
    "event_payload_tamper": "FAIL_CLOSED"
  },
  "boundaries": {
    "task_closeout_is_not_installation": true,
    "task_closeout_is_not_provider_activation": true,
    "task_closeout_is_not_protected_effect_authority": true,
    "passing_tests_do_not_close_unproven_surfaces": true,
    "destructive_cleanup_is_separate_effect": true,
    "independent_review_not_implied": true
  },
  "correction_recurrence": {
    "event": "TASK_CORRECTION",
    "record_method": "TaskExecutionLedger.record_correction",
    "qualified_method": "QualifiedVeraRuntime.record_task_correction",
    "binds": [
      "exact task subject",
      "task packet digest",
      "correction summary",
      "obsolete route",
      "required change",
      "current owner reference",
      "provenance references"
    ],
    "provenance_required": true,
    "next_checkpoint_must_address_all_unresolved_corrections": true,
    "next_checkpoint_requires_one_or_more": [
      "method_change",
      "regression_guard",
      "blocker_classification"
    ],
    "unresolved_correction_forbids_closeout": true,
    "obsolete_route_may_not_be_silently_reoffered": true
  },
  "dependencies": {
    "event": "TASK_DEPENDENCY",
    "ledger_method": "TaskExecutionLedger.bind_dependency",
    "qualified_binding_method": "QualifiedVeraRuntime.bind_task_dependency",
    "kinds": [
      "EFFECT",
      "COORDINATION_COMMAND",
      "PROVIDER_EFFECT"
    ],
    "exact_subject_and_packet_bound": true,
    "exact_replay_idempotent": true,
    "duplicate_target_under_different_dependency_id": "DENY",
    "qualified_scoped_paths": {
      "coordination": "QualifiedVeraRuntime.invoke_task_coordination",
      "provider": "QualifiedVeraRuntime.prepare_task_provider_effect",
      "pc": "QualifiedVeraRuntime.prepare_task_pc_job using EFFECT target pc:<envelope_id>"
    },
    "assessment_method": "QualifiedVeraRuntime.assess_task_dependencies",
    "statuses": [
      "SATISFIED",
      "MISSING",
      "PENDING",
      "RECOVERY_REQUIRED",
      "TERMINAL_UNSATISFIED",
      "PROVENANCE_MISMATCH"
    ],
    "success_semantics": {
      "effect": [
        "COMMITTED",
        "RECONCILED_COMMITTED"
      ],
      "coordination": "durable result journal + successful terminal effect + repository consistency",
      "provider": [
        "COMMITTED",
        "RECONCILED_COMMITTED"
      ]
    },
    "terminal_no_effect_is_satisfied": false,
    "unresolved_or_unsatisfied_forbids_closeout": true,
    "restart_context_surfaces_assessment": true,
    "closeout_auto_appends_dependency_evidence_digest": true,
    "cancellation": {
      "event": "TASK_DEPENDENCY_CANCELLED",
      "qualified_method": "QualifiedVeraRuntime.cancel_task_dependency",
      "allowed_only_when": "dependency assessment is MISSING and target has no durable preparation/execution evidence",
      "post_start_cancellation": "DENY",
      "cancelled_dependency_id_reuse": "DENY",
      "automatic_preparation_failure_rollback": "qualified task-scoped wrappers cancel the dependency only when the target never acquired durable preparation/execution evidence",
      "closeout_semantics": "cancelled dependencies are no longer required work, but their cancellation event digest is preserved in closeout evidence",
      "restart_surface": "TaskDependencyAssessment.cancellation_allowed",
      "automatic_restart_cancellation": false
    },
    "ownership": {
      "one_durable_owner_per_kind_target": true,
      "cross_task_evidence_reuse": "DENY",
      "post_hoc_dependency_claim": "DENY",
      "exact_binding_replay": "IDEMPOTENT"
    },
    "serialization": {
      "task_action_lock": "PortableFileLock",
      "closeout_serialized_against_task_scoped_mutation": true,
      "task_scoped_outbound_preparation_holds_lock": true
    }
  },
  "delegation_ownership": {
    "contract": "architecture/VERA_TASK_DELEGATION_OWNERSHIP_V1.json",
    "qualified_methods": [
      "QualifiedVeraRuntime.delegate_task_work",
      "QualifiedVeraRuntime.reassign_task_delegation",
      "QualifiedVeraRuntime.return_task_delegation",
      "QualifiedVeraRuntime.cancel_task_delegation"
    ],
    "exact_scope": [
      "repository",
      "ref",
      "subject"
    ],
    "one_active_owner_per_scope": true,
    "assignee_owned_until": [
      "returned",
      "cancelled",
      "explicitly reassigned"
    ],
    "active_delegation_forbids_closeout": true,
    "terminal_delegation_evidence_auto_carried_into_closeout": true,
    "restart_context_exposes_active_owner": true,
    "return_shape_enforced": true,
    "active_owner_reference": "vera_core.TaskDelegationRef",
    "stale_owner_reference_after_reassignment": "DENY"
  }
}

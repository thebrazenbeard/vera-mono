    },
    "absorption_rule": "COPY_OR_ADAPT_MECHANISMS_INTO_VERA_MONO_WITH_EXACT_PROVENANCE; DO_NOT_CREATE_SIBLING_RUNTIME_DEPENDENCIES",
    "rejection_rule": "DO_NOT_ABSORB_PROJECT_IDENTITY_OR_DOMAIN_SPECIFIC_CONTENT_WHEN_ONLY_THE_GENERAL_MECHANISM_IS_USEFUL",
    "mandatory_comparison": [
      "mechanism already exists in vera-mono",
      "donor is materially stronger than current mechanism",
      "donor semantics match Vera authority and evidence boundaries",
      "donor can be independently tested after absorption",
      "donor introduces no undeclared runtime dependency"
    ]
  }
}

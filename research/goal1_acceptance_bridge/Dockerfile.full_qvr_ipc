# Goal 1 research FULL selected-class IPC test image.
# Exact PR82 source must be staged in a fresh git-archive build context.
# Base manifest + Python dependency versions pinned (wheels not hash-attested).
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
WORKDIR /opt/vera
COPY research/goal1_acceptance_bridge/requirements.full_qvr_probe.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir -r /tmp/requirements.lock
COPY . /opt/vera
RUN python -m pip install --no-cache-dir --no-deps . && python -c "from vera_core import QualifiedVeraRuntime; assert hasattr(QualifiedVeraRuntime,'consume_local_cognition')"
RUN mkdir -p /state && chown 65534:65534 /state
USER 65534:65534
ENTRYPOINT ["python","-u","/opt/vera/research/goal1_acceptance_bridge/full_qvr_stdio_worker.py"]
